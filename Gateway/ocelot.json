{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/v1/Customer/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": "44389"
        }
      ],
      "UpstreamPathTemplate": "/gateway/Customer/{everything}",
      "UpstreamHttpMethod": ["GET", "POST", "PUT", "DELETE"],
      "SwaggerKey": "user"
    },
    {
      "DownstreamPathTemplate": "/api/v1/Product/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": "44357"
        }
      ],
      "UpstreamPathTemplate": "/gateway/Product/{everything}",
      "UpstreamHttpMethod": ["GET", "POST", "PUT", "DELETE"],
      "SwaggerKey": "product"
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "user",
      "Config": [
        {
          "Name": "User Api",
          "Version": "v1",
          "Url": "https://localhost:44389/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "product",
      "Config": [
        {
          "Name": "Product Api",
          "Version": "v1",
          "Url": "https://localhost:44357/swagger/v1/swagger.json"
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost"
  }
}
